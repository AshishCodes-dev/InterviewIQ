# Server Port
PORT=8000

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/InterviewIQ?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# OpenRouter AI API Key (for Gemini/DeepSeek/Claude models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
